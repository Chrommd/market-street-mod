	<TABLE name='CaptureSceneDialogue' RowCount='10' TableInfoID = '396' FieldCnt = '3'>
		<FIELDINFO Name='ID' IsKey='1' DataType='INT'></FIELDINFO>
		<FIELDINFO Name='Value_girl' IsKey='0' DataType='String'></FIELDINFO>
		<FIELDINFO Name='Value_boy' IsKey='0' DataType='String'></FIELDINFO>
		<ROW>
			<ID>100</ID>
			<Value_boy><![CDATA[#@horse_name# 누구라도 앞지를 수 있을 것 같아!]]></Value_boy>
			<Value_girl><![CDATA[#@horse_name# 눈을 뜰 수 없을 정도로 빠르구나!]]></Value_girl>
		</ROW>
		<ROW>
			<ID>101</ID>
			<Value_boy><![CDATA[#@horse_name# 짜식 넌 정말 멋진 친구야, 함께 있으면 즐겁다니까.]]></Value_boy>
			<Value_girl><![CDATA[#@horse_name# 너와 함께 하는 시간이 너무 즐거워.]]></Value_girl>
		</ROW>
		<ROW>
			<ID>102</ID>
			<Value_boy><![CDATA[나보다 멋진 라이더는 어디에도 없을걸?]]></Value_boy>
			<Value_girl><![CDATA[그 누구보다 훌륭한 라이더가 되겠어!]]></Value_girl>
		</ROW>
		<ROW>
			<ID>103</ID>
			<Value_boy><![CDATA[얏호! 정말 기분 좋은걸? 그렇지 않니 #@horse_name#?]]></Value_boy>
			<Value_girl><![CDATA[얏호! 정말 상쾌해! 그렇지 않니 #@horse_name#?]]></Value_girl>
		</ROW>
		<ROW>
			<ID>104</ID>
			<Value_boy><![CDATA[우리야 말로 진정한 최고야!]]></Value_boy>
			<Value_girl><![CDATA[난 너무 행복해 언제나 함께하자 #@horse_name#]]></Value_girl>
		</ROW>
		<ROW>
			<ID>105</ID>
			<Value_boy><![CDATA[#@horse_name# 네 옆엔 내가 항상 있으니 걱정 말라구.]]></Value_boy>
			<Value_girl><![CDATA[#@horse_name# 아프지 마. 내가 항상 옆에 있잖아.]]></Value_girl>
		</ROW>
		<ROW>
			<ID>106</ID>
			<Value_boy><![CDATA[바람 속을 헤엄치는 것 같은 기분이야 그렇지 #@horse_name#?]]></Value_boy>
			<Value_girl><![CDATA[바람 속을 헤엄치는 것 같은 기분이야 그렇지 #@horse_name#?]]></Value_girl>
		</ROW>
		<ROW>
			<ID>107</ID>
			<Value_boy><![CDATA[우리를 막으려면 고생 좀 할걸? 그렇지 #@horse_name#?]]></Value_boy>
			<Value_girl><![CDATA[우리를 막으려면 고생 좀 할 거예요. 그렇지 #@horse_name#?]]></Value_girl>
		</ROW>
		<ROW>
			<ID>108</ID>
			<Value_boy><![CDATA[#@horse_name# 고생 많았어! 오늘은 신 나게 쉬어보자!]]></Value_boy>
			<Value_girl><![CDATA[#@horse_name# 많이 힘들었지? 조금은 여유롭게 보내볼까?]]></Value_girl>
		</ROW>
		<ROW>
			<ID>109</ID>
			<Value_boy><![CDATA[#@horse_name#! 이런 속도라면 대회 우승 상금은 우리 차지야!]]></Value_boy>
			<Value_girl><![CDATA[#@horse_name#! 이런 속도라면 대회 우승 상금은 우리 차지야!]]></Value_girl>
		</ROW>
	</TABLE>
