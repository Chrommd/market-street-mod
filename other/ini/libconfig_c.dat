	<TABLE name='CareSkillInfo' RowCount='12' TableInfoID = '431' FieldCnt = '7'>
		<FIELDINFO Name='SkillId' IsKey='1' DataType='INT' InputType='pkKey'></FIELDINFO>
		<FIELDINFO Name='SortID' IsKey='0' DataType='INT'></FIELDINFO>
		<FIELDINFO Name='Name' IsKey='0' DataType='String'></FIELDINFO>
		<FIELDINFO Name='Icon' IsKey='0' DataType='String'></FIELDINFO>
		<FIELDINFO Name='Desc' IsKey='0' DataType='String'></FIELDINFO>
		<FIELDINFO Name='Scope' IsKey='0' DataType='Enum'></FIELDINFO>
		<FIELDINFO Name='RankInfo' IsKey='0' DataType='String' InputType='1fkKey'></FIELDINFO>
		<ROW>
			<Desc><![CDATA[먹이를 좀 더 먹을 수 있게 됩니다.

<font color=#629a00>배부름 설명 :</font>
말이 <font color=#ff7e00>조금 배부를 때는 가끔 안 먹을 때</font>가 있고, <font color=#ff7e00>배부를 때는 먹지 않습니다.</font>]]></Desc>
			<Icon><![CDATA[careskillicon_1]]></Icon>
			<Name><![CDATA[요리사]]></Name>
			<RankInfo><![CDATA[CareSkillRankInfo]]></RankInfo>
			<Scope>0</Scope>
			<SkillId>1</SkillId>
			<SortID>1</SortID>
		</ROW>
		<ROW>
			<Desc><![CDATA[말과 하나가 되어 친밀도 최대값이 증가합니다.]]></Desc>
			<Icon><![CDATA[careskillicon_2]]></Icon>
			<Name><![CDATA[일심동체]]></Name>
			<RankInfo><![CDATA[CareSkillRankInfo]]></RankInfo>
			<Scope>0</Scope>
			<SkillId>2</SkillId>
			<SortID>3</SortID>
		</ROW>
		<ROW>
			<Desc><![CDATA[먹이를 먹을 때 일정 확률로 행운이 좋아집니다.]]></Desc>
			<Icon><![CDATA[careskillicon_3]]></Icon>
			<Name><![CDATA[한약사]]></Name>
			<RankInfo><![CDATA[CareSkillRankInfo]]></RankInfo>
			<Scope>1</Scope>
			<SkillId>3</SkillId>
			<SortID>6</SortID>
		</ROW>
		<ROW>
			<Desc><![CDATA[같은 부분을 여러 번 씻겨주면 말의 몸에서 좀 더 예쁜 윤기와 빛이 납니다.]]></Desc>
			<Icon><![CDATA[careskillicon_4]]></Icon>
			<Name><![CDATA[스타일리스트]]></Name>
			<RankInfo><![CDATA[CareSkillRankInfo]]></RankInfo>
			<Scope>0</Scope>
			<SkillId>4</SkillId>
			<SortID>7</SortID>
		</ROW>
		<ROW>
			<Desc><![CDATA[주행이 끝났을 때 몸이 더러워지는 양이 감소합니다.]]></Desc>
			<Icon><![CDATA[careskillicon_5]]></Icon>
			<Name><![CDATA[미화원]]></Name>
			<RankInfo><![CDATA[CareSkillRankInfo]]></RankInfo>
			<Scope>7</Scope>
			<SkillId>5</SkillId>
			<SortID>2</SortID>
		</ROW>
		<ROW>
			<Desc><![CDATA[씻겨주기를 할 때 일정 확률로 행운이 좋아집니다.]]></Desc>
			<Icon><![CDATA[careskillicon_6]]></Icon>
			<Name><![CDATA[미용관리사]]></Name>
			<RankInfo><![CDATA[CareSkillRankInfo]]></RankInfo>
			<Scope>2</Scope>
			<SkillId>6</SkillId>
			<SortID>8</SortID>
		</ROW>
		<ROW>
			<Desc><![CDATA[훌륭한 조련으로 인해 놀아주기를 좀 더 할 수 있게 됩니다.]]></Desc>
			<Icon><![CDATA[careskillicon_7]]></Icon>
			<Name><![CDATA[조련 마스터]]></Name>
			<RankInfo><![CDATA[CareSkillRankInfo]]></RankInfo>
			<Scope>3</Scope>
			<SkillId>7</SkillId>
			<SortID>11</SortID>
		</ROW>
		<ROW>
			<Desc><![CDATA[놀아주기 Perfect 범위가 증가합니다.

<font color=#629a00>Perfect 범위 설명 :</font>
<font color=#ff7e00>Perfect 범위</font>를 맞추면 높은 확률로 <font color=#ff7e00>Critical</font>이 발생합니다.
<font color=#ff7e00>Critical</font>이 발생하면 말은 <font color=#ff7e00>지루해하지</font> 않습니다.
놀아주기 <font color=#ff7e00>Perfect 범위</font>는 게이지의 <font color=#ff7e00>주황색 범위</font>입니다.]]></Desc>
			<Icon><![CDATA[careskillicon_8]]></Icon>
			<Name><![CDATA[일확천금]]></Name>
			<RankInfo><![CDATA[CareSkillRankInfo]]></RankInfo>
			<Scope>0</Scope>
			<SkillId>8</SkillId>
			<SortID>9</SortID>
		</ROW>
		<ROW>
			<Desc><![CDATA[놀아주기에 성공해도 말은 쉽게 지루해하지 않게 됩니다.

<font color=#629a00>지루함 설명 : </font>
놀아주기에 성공하면 싫증 상태는 <font color=#ff7e00>"놀고 싶음"</font>에서 <font color=#ff7e00>"지루함"</font> 상태로 단계적으로 변합니다.
<font color=#ff7e00>"지루함" 상태</font>에서는 <font color=#ff7e00>놀아주기를 할 수 없으며</font>, <font color=#ff7e00>다음 날 아침에 "놀고 싶음" 상태</font>로 돌아옵니다.]]></Desc>
			<Icon><![CDATA[careskillicon_9]]></Icon>
			<Name><![CDATA[장인의 자랑]]></Name>
			<RankInfo><![CDATA[CareSkillRankInfo]]></RankInfo>
			<Scope>3</Scope>
			<SkillId>9</SkillId>
			<SortID>10</SortID>
		</ROW>
		<ROW>
			<Desc><![CDATA[주행에서 경상 당할 확률이 줄어듭니다.]]></Desc>
			<Icon><![CDATA[careskillicon_10]]></Icon>
			<Name><![CDATA[안전주의자]]></Name>
			<RankInfo><![CDATA[CareSkillRankInfo]]></RankInfo>
			<Scope>5</Scope>
			<SkillId>10</SkillId>
			<SortID>12</SortID>
		</ROW>
		<ROW>
			<Desc><![CDATA[자연치료되는데 필요한 게임수가 줄어듭니다.

<font color=#629a00>자연치료 설명 :</font>
<font color=#ff7e00>경상을 당한 시점</font>으로부터 <font color=#ff7e00>5경기</font>가 지나면 <font color=#ff7e00>자연치료</font>됩니다. 경상 당한 말로 직접 레이스를 해도 되고, 다른 말로 레이스를 해도 자연치료가 가능합니다.

경상을 당한 말로 직접 레이스를 해서 <font color=#ff7e00>자연치료에 도전할 때</font>는 <font color=#ff7e00>중상을 당할 수 있기 때문에 주의</font>가 필요합니다.]]></Desc>
			<Icon><![CDATA[careskillicon_11]]></Icon>
			<Name><![CDATA[치료술사]]></Name>
			<RankInfo><![CDATA[CareSkillRankInfo]]></RankInfo>
			<Scope>6</Scope>
			<SkillId>11</SkillId>
			<SortID>5</SortID>
		</ROW>
		<ROW>
			<Desc><![CDATA[부상 치료 시 일정 게임수 동안 행운은 최상이 됩니다. ]]></Desc>
			<Icon><![CDATA[careskillicon_12]]></Icon>
			<Name><![CDATA[심리치료사]]></Name>
			<RankInfo><![CDATA[CareSkillRankInfo]]></RankInfo>
			<Scope>4</Scope>
			<SkillId>12</SkillId>
			<SortID>4</SortID>
		</ROW>
	</TABLE>
