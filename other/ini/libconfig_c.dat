		<ROW>
			<ID>742</ID>
			<Image><![CDATA[img_quest_npc_003-surprise]]></Image>
			<NpcID>3</NpcID>
			<Priority>0</Priority>
			<QuestPack>0</QuestPack>
			<QuestTID>13015</QuestTID>
			<Speech><![CDATA[$(Name), 조금 전에 흥미로운 이야기를 들었는데 말이야.]]></Speech>
