	<TABLE name='IniImportTestTable' RowCount='13' TableInfoID = '328' FieldCnt = '7'>
		<FIELDINFO Name='Index' IsKey='1' DataType='INT'></FIELDINFO>
		<FIELDINFO Name='PostType' IsKey='0' DataType='Enum'></FIELDINFO>
		<FIELDINFO Name='MissionId' IsKey='0' DataType='INT'></FIELDINFO>
		<FIELDINFO Name='Sender' IsKey='0' DataType='String'></FIELDINFO>
		<FIELDINFO Name='Title' IsKey='0' DataType='String'></FIELDINFO>
		<FIELDINFO Name='Content' IsKey='0' DataType='String'></FIELDINFO>
		<FIELDINFO Name='Date' IsKey='0' DataType='String'></FIELDINFO>
		<ROW>
			<Content><![CDATA[오늘 목장에 이사오신 기념으로 당근 10개와 엘피 100원을 드릴께요. 새로운 세상에 적응하려면 필요하실 겁니다. 사양말고 받아두세요^^]]></Content>
			<Date><![CDATA[09.03.27]]></Date>
			<Index>1</Index>
			<MissionId>0</MissionId>
			<PostType>0</PostType>
			<Sender><![CDATA[스타토]]></Sender>
			<Title><![CDATA[환영 메세지]]></Title>
		</ROW>
		<ROW>
			<Content><![CDATA[축하합니다! 새로운 미션에 입장할 자격이 되었어요. 아래 버턴을 클릭해서 새로운 미션에 도전해 보세요. 보상: 2단 점프 조련서]]></Content>
			<Date><![CDATA[09.03.27]]></Date>
			<Index>2</Index>
			<MissionId>1</MissionId>
			<PostType>2</PostType>
			<Sender><![CDATA[스타토]]></Sender>
			<Title><![CDATA[첫번째 미션]]></Title>
		</ROW>
		<ROW>
			<Content><![CDATA[이번 미션은 코스에 배치된 아이템을 많이 획득해야 됩니다. 스피드 보다는 기동력이 필요한 미션이죠. 이번에도 멋진 성적 기대할께요!]]></Content>
			<Date><![CDATA[09.03.27]]></Date>
			<Index>4</Index>
			<MissionId>8</MissionId>
			<PostType>2</PostType>
			<Sender><![CDATA[스타토]]></Sender>
			<Title><![CDATA[박차 획득하기]]></Title>
		</ROW>
		<ROW>
			<Content><![CDATA[우와. 제가 잠깐 바쁜 사이에 레벨 5가 되셨군요! 지금부터 초급 기사단 채널을 이용하실 수 있습니다. 더 많은 코스와의 모험이 기다리고 있겠군요. 앞으로 멋진 기사님으로 성장하시길 기대할게요!]]></Content>
			<Date><![CDATA[09.03.27]]></Date>
			<Index>6</Index>
			<MissionId>0</MissionId>
			<PostType>0</PostType>
			<Sender><![CDATA[스타토]]></Sender>
			<Title><![CDATA[초급기사단 승급]]></Title>
		</ROW>
		<ROW>
			<Content><![CDATA[하하! 이번에는 제가 준비한 깜짝 미션이랍니다. 이번에 저희집 당근 농사가 풍년이라 기사님의 실력도 테스트할 겸 한번 준비해봤어요. 활을 사용하셔서, 저에게서  더 많은 당근을 빼앗아 보세요.]]></Content>
			<Date><![CDATA[09.03.27]]></Date>
			<Index>8</Index>
			<MissionId>7</MissionId>
			<PostType>2</PostType>
			<Sender><![CDATA[스타토]]></Sender>
			<Title><![CDATA[당근 뺏기 미션]]></Title>
		</ROW>
		<ROW>
			<Content><![CDATA[이번엔 기사단장님으로부터 어려운 미션이 도착했어요. 마을을 어지럽히는 바실리스크를 해치우라고 하는군요. 지금까지도 잘 해오셨으니 걱정하지 않아도 되겠지만요. 마음을 가다듬어 전투에 임하세요.
행운이 함께하길!]]></Content>
			<Date><![CDATA[09.03.27]]></Date>
			<Index>11</Index>
			<MissionId>12</MissionId>
			<PostType>2</PostType>
			<Sender><![CDATA[스타토]]></Sender>
			<Title><![CDATA[전투 미션 참가]]></Title>
		</ROW>
		<ROW>
			<Content><![CDATA[2단 점프 액션은 많이 익히셨나요? 여기 2단 점프 능력을 테스트 해보는 미션에 도전해 보세요.]]></Content>
			<Date><![CDATA[ ]]></Date>
			<Index>3</Index>
			<MissionId>2</MissionId>
			<PostType>2</PostType>
			<Sender><![CDATA[스타토]]></Sender>
			<Title><![CDATA[2단 점프 미션]]></Title>
		</ROW>
		<ROW>
			<Content><![CDATA[하늘을 나는 글라이딩 조련 능력을 익혀보는 미션입니다. 능숙한 날개 사용법을 익히러 가요.]]></Content>
			<Date><![CDATA[ ]]></Date>
			<Index>7</Index>
			<MissionId>3</MissionId>
			<PostType>2</PostType>
			<Sender><![CDATA[스타토]]></Sender>
			<Title><![CDATA[글라이딩 미션]]></Title>
		</ROW>
		<ROW>
			<Content><![CDATA[움직이는 땅을 2단 점프로 멋지게 점프하는 아슬아슬한 미션입니다. 준비가 되셨다면 도전해 보세요.]]></Content>
			<Date><![CDATA[ ]]></Date>
			<Index>9</Index>
			<MissionId>5</MissionId>
			<PostType>2</PostType>
			<Sender><![CDATA[스타토]]></Sender>
			<Title><![CDATA[이동형 2단 점프 미션]]></Title>
		</ROW>
		<ROW>
			<Content><![CDATA[저를 따라와 보세요.]]></Content>
			<Date><![CDATA[ ]]></Date>
			<Index>5</Index>
			<MissionId>7</MissionId>
			<PostType>2</PostType>
			<Sender><![CDATA[스타토]]></Sender>
			<Title><![CDATA[당근 먹기 미션]]></Title>
		</ROW>
		<ROW>
			<Content><![CDATA[움직이는 땅을 1단 점프로 넘어가는 미션입니다. 준비가 되셨다면 도전해 보세요.]]></Content>
			<Date><![CDATA[ ]]></Date>
			<Index>10</Index>
			<MissionId>4</MissionId>
			<PostType>2</PostType>
			<Sender><![CDATA[스타토]]></Sender>
			<Title><![CDATA[이동형 1단 점프 미션]]></Title>
		</ROW>
		<ROW>
			<Content><![CDATA[드디어 고난이도 미션 등장!! 지금 배운 모든 조련 능력을 사용하여 코스를 공략하세요.]]></Content>
			<Date><![CDATA[ ]]></Date>
			<Index>12</Index>
			<MissionId>6</MissionId>
			<PostType>2</PostType>
			<Sender><![CDATA[스타토]]></Sender>
			<Title><![CDATA[이동형 글라이딩]]></Title>
		</ROW>
		<ROW>
			<Content><![CDATA[드디어 고난이도 미션 등장!! 지금 배운 모든 조련 능력을 사용하여 코스를 공략하세요.]]></Content>
			<Date><![CDATA[ ]]></Date>
			<Index>13</Index>
			<MissionId>13</MissionId>
			<PostType>2</PostType>
			<Sender><![CDATA[스타토]]></Sender>
			<Title><![CDATA[이동형 글라이딩]]></Title>
		</ROW>
