			<CharMultiAbility><![CDATA[MountMultiAbility]]></CharMultiAbility>
			<ConsumeType>0</ConsumeType>
			<Desc><![CDATA[업데이트 예정]]></Desc>
			<ItemFunc>0</ItemFunc>
			<ItemFuncValue>0</ItemFuncValue>
