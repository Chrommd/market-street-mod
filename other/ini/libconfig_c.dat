			<ParentButtons>1</ParentButtons>
			<ParentIDs><![CDATA[10]]></ParentIDs>
			<Priority>0</Priority>
			<VoiceFile><![CDATA[ ]]></VoiceFile>
		</ROW>
		<ROW>
			<Chat><![CDATA[To take good care of your horse,
I’ll need to know its name.
Won’t you tell me?]]></Chat>
