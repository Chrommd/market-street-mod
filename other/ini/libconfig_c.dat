			<NpcID>4</NpcID>
			<Priority>5</Priority>
			<QuestPack>2</QuestPack>
			<QuestTID>11045</QuestTID>
			<Speech><![CDATA[으음 일단은 바뀐 분위기에 맞게
식구들 의상을 챙겨줘야 하겠네.]]></Speech>
			<Voice><![CDATA[ ]]></Voice>
		</ROW>
