	<TABLE name='PCBangStrings' RowCount='12' TableInfoID = '477' FieldCnt = '2'>
		<FIELDINFO Name='KEY' IsKey='1' DataType='String'></FIELDINFO>
		<FIELDINFO Name='Value' IsKey='0' DataType='String'></FIELDINFO>
		<ROW>
			<KEY><![CDATA[Explanation]]></KEY>
			<Value><![CDATA[* <font color=#ff7e00>매시간 정시에</font> 새로운 PC방 대여 말을 선택할 수 있습니다.
* 매시간 정시에 4마리의 말이 모두 다른 말로 새롭게 바뀝니다.
* PC방 말을 대여하고 있는 동안 현재 타고 있는 말은 탈 수 없습니다.
* PC방 대여 말로 플레이하는 동안 경험치, 숙련도 등은 <font color=#ff7e00>현재 타고 있는 말이 성장</font> 합니다.]]></Value>
		</ROW>
		<ROW>
			<KEY><![CDATA[Condition_1]]></KEY>
			<Value><![CDATA[PC방 말을 대여 받을 수 있습니다.]]></Value>
		</ROW>
		<ROW>
			<KEY><![CDATA[Condition_2]]></KEY>
			<Value><![CDATA[%d분 후에 말을 대여 할 수 있습니다.]]></Value>
		</ROW>
		<ROW>
			<KEY><![CDATA[RentCancel_CR_ERROR]]></KEY>
			<Value><![CDATA[서버오류]]></Value>
		</ROW>
		<ROW>
			<KEY><![CDATA[RentCancel_CR_NOT_SUPPORT]]></KEY>
			<Value><![CDATA[지금은 지원히지 않습니다.]]></Value>
		</ROW>
		<ROW>
			<KEY><![CDATA[RentCancel_CR_AUTH]]></KEY>
			<Value><![CDATA[권한이 없습니다.]]></Value>
		</ROW>
		<ROW>
			<KEY><![CDATA[RentCancel_CR_INVALID_SLOT]]></KEY>
			<Value><![CDATA[슬롯을 잘못 선택했습니다.]]></Value>
		</ROW>
		<ROW>
			<KEY><![CDATA[RentCancel_CR_INVALID_MOUNT]]></KEY>
			<Value><![CDATA[잘못된 말을 선택했습니다.]]></Value>
		</ROW>
		<ROW>
			<KEY><![CDATA[RentCancel_CR_ALREADY_RENT]]></KEY>
			<Value><![CDATA[이번 시간대에는 이미 빌렸습니다.
%d 분 후에 말 환생을 이용할수 있습니다.]]></Value>
		</ROW>
		<ROW>
			<KEY><![CDATA[RentCancel_CR_REGEN_INFO]]></KEY>
			<Value><![CDATA[시간대가 바뀌어서 새 말들 정보가 생성되었습니다.]]></Value>
		</ROW>
		<ROW>
			<KEY><![CDATA[ItemNotice]]></KEY>
			<Value><![CDATA[*말장비와 캐릭터의상은  PC방에서만 사용가능합니다.
*관리 아이템은 하루에 한번만 받을 수 있습니다.
*획득한 아이템은 내장비에서 확인할 수 있습니다.]]></Value>
		</ROW>
		<ROW>
			<KEY><![CDATA[RewardItemNotice]]></KEY>
			<Value><![CDATA[%s 를 받았습니다. 내장비에서 확인해주세요.]]></Value>
		</ROW>
	</TABLE>
