	<TABLE name='LoadingTip' RowCount='57' TableInfoID = '384' FieldCnt = '6'>
		<FIELDINFO Name='ID' IsKey='1' DataType='INT'></FIELDINFO>
		<FIELDINFO Name='Type' IsKey='0' DataType='Enum'></FIELDINFO>
		<FIELDINFO Name='InitCount' IsKey='0' DataType='INT'></FIELDINFO>
		<FIELDINFO Name='Tip' IsKey='0' DataType='String'></FIELDINFO>
		<FIELDINFO Name='Condition' IsKey='0' DataType='Enum'></FIELDINFO>
		<FIELDINFO Name='ConditionArg' IsKey='0' DataType='INT'></FIELDINFO>
		<ROW>
			<Condition>0</Condition>
			<ConditionArg>0</ConditionArg>
			<ID>1</ID>
			<InitCount>1</InitCount>
			<Tip><![CDATA[타임어택모드 플레이 중 <Shift + R> 조작으로 경기를 빠르게 다시 시작할 수 있습니다.]]></Tip>
			<Type>1</Type>
		</ROW>
		<ROW>
			<Condition>0</Condition>
			<ConditionArg>0</ConditionArg>
			<ID>2</ID>
			<InitCount>1</InitCount>
			<Tip><![CDATA[개인전 핸디캡은 연승 중인 유저를 제외한 모든 유저의 기본 속도를 증가시켜줍니다.]]></Tip>
			<Type>1</Type>
		</ROW>
		<ROW>
			<Condition>0</Condition>
			<ConditionArg>0</ConditionArg>
			<ID>3</ID>
			<InitCount>1</InitCount>
			<Tip><![CDATA[스피드 팀전에서의 핸디캡은 기본속도가 증가하고 팀게이지가 더 많이 차게됩니다.]]></Tip>
			<Type>1</Type>
		</ROW>
		<ROW>
			<Condition>0</Condition>
			<ConditionArg>0</ConditionArg>
			<ID>4</ID>
			<InitCount>1</InitCount>
			<Tip><![CDATA[<좌(우)+Shift>를 이용한 슬라이딩으로 급한 커브길을 빠르게 달려보세요.]]></Tip>
			<Type>1</Type>
		</ROW>
		<ROW>
			<Condition>0</Condition>
			<ConditionArg>0</ConditionArg>
			<ID>5</ID>
			<InitCount>1</InitCount>
			<Tip><![CDATA[라이벌이 남기는 바람의 흔적은 당신의 말을 더욱 빨리 달릴 수 있게 도와줍니다.]]></Tip>
			<Type>1</Type>
		</ROW>
		<ROW>
			<Condition>0</Condition>
			<ConditionArg>0</ConditionArg>
			<ID>6</ID>
			<InitCount>1</InitCount>
			<Tip><![CDATA[점프 중 <Z>키를 누르고 있으면 은빛 날개를 이용하여 하늘을 날 수 있습니다.]]></Tip>
			<Type>1</Type>
		</ROW>
		<ROW>
			<Condition>0</Condition>
			<ConditionArg>0</ConditionArg>
			<ID>7</ID>
			<InitCount>1</InitCount>
			<Tip><![CDATA[박차(부스터)를 사용하여 팀게이지를 모아 스피드 팀전에서 승리해 보세요.]]></Tip>
			<Type>1</Type>
		</ROW>
		<ROW>
			<Condition>0</Condition>
			<ConditionArg>0</ConditionArg>
			<ID>8</ID>
			<InitCount>1</InitCount>
			<Tip><![CDATA[연속으로<Ctrl>키를 누르면 더욱 강력한 박차(부스터)를 사용 할 수 있습니다.]]></Tip>
			<Type>1</Type>
		</ROW>
		<ROW>
			<Condition>0</Condition>
			<ConditionArg>0</ConditionArg>
			<ID>9</ID>
			<InitCount>1</InitCount>
			<Tip><![CDATA[점프 장애물을 가운데로 넘으면 더 많은 박차게이지를 얻을 수 있습니다.]]></Tip>
			<Type>1</Type>
		</ROW>
		<ROW>
			<Condition>0</Condition>
			<ConditionArg>0</ConditionArg>
			<ID>10</ID>
			<InitCount>1</InitCount>
			<Tip><![CDATA[은색편자 획득시 일정량의 박차게이지가 채워집니다.]]></Tip>
			<Type>1</Type>
		</ROW>
		<ROW>
			<Condition>0</Condition>
			<ConditionArg>0</ConditionArg>
			<ID>11</ID>
			<InitCount>1</InitCount>
			<Tip><![CDATA[금색편자 획득시 박차 한 개를 획득 할 수 있습니다.]]></Tip>
			<Type>1</Type>
		</ROW>
		<ROW>
			<Condition>2</Condition>
			<ConditionArg>5</ConditionArg>
			<ID>12</ID>
			<InitCount>1</InitCount>
			<Tip><![CDATA[바람의 흔적을 연속으로 획득하면 더욱 빠르게 달릴 수 있습니다.]]></Tip>
			<Type>1</Type>
		</ROW>
		<ROW>
			<Condition>2</Condition>
			<ConditionArg>5</ConditionArg>
			<ID>13</ID>
			<InitCount>1</InitCount>
			<Tip><![CDATA[슬라이딩을 조합할 경우 더 강한 대쉬를 사용할 수 있습니다.]]></Tip>
			<Type>1</Type>
		</ROW>
		<ROW>
			<Condition>0</Condition>
			<ConditionArg>0</ConditionArg>
			<ID>14</ID>
			<InitCount>1</InitCount>
			<Tip><![CDATA[개인전 핸디캡은 연승중인 유저를 제외한 모든 유저의 기본 속도를 증가시켜줍니다.]]></Tip>
			<Type>2</Type>
		</ROW>
		<ROW>
			<Condition>0</Condition>
			<ConditionArg>0</ConditionArg>
			<ID>15</ID>
			<InitCount>1</InitCount>
			<Tip><![CDATA[마법 팀전에서의 핸디캡은 기본 속도가 증가하고 마법게이지가 더 많이 차게됩니다.]]></Tip>
			<Type>2</Type>
		</ROW>
		<ROW>
			<Condition>0</Condition>
			<ConditionArg>0</ConditionArg>
			<ID>16</ID>
			<InitCount>1</InitCount>
			<Tip><![CDATA[팀전에서의 팀속도버프는 팀원 모두의 속도를 증가시키는 강력한 마법입니다.]]></Tip>
			<Type>2</Type>
		</ROW>
		<ROW>
			<Condition>0</Condition>
			<ConditionArg>0</ConditionArg>
			<ID>17</ID>
			<InitCount>1</InitCount>
			<Tip><![CDATA[팀전에서의 팀마법력버프는 팀원 모두의 마법에 크리티컬 효과를 부여하는 마법입니다.]]></Tip>
			<Type>2</Type>
		</ROW>
		<ROW>
			<Condition>0</Condition>
			<ConditionArg>0</ConditionArg>
			<ID>18</ID>
			<InitCount>1</InitCount>
			<Tip><![CDATA[획득한 마법을 <Ctrl>키를 이용하여 라이벌에게 사용해보세요.]]></Tip>
			<Type>2</Type>
		</ROW>
		<ROW>
			<Condition>0</Condition>
			<ConditionArg>0</ConditionArg>
			<ID>19</ID>
			<InitCount>1</InitCount>
			<Tip><![CDATA[크리티컬이 더해진 마법은 라이벌에게 치명적인 피해를 입힐 수 있습니다.]]></Tip>
			<Type>2</Type>
		</ROW>
		<ROW>
			<Condition>0</Condition>
			<ConditionArg>0</ConditionArg>
			<ID>20</ID>
			<InitCount>1</InitCount>
			<Tip><![CDATA[마법구는 조준한 대상을 강한 힘으로 쓰러뜨릴 수 있습니다.]]></Tip>
			<Type>2</Type>
		</ROW>
		<ROW>
			<Condition>0</Condition>
			<ConditionArg>0</ConditionArg>
			<ID>21</ID>
			<InitCount>1</InitCount>
			<Tip><![CDATA[어둠의 화염은 조준한 대상을 암흑상태로 만들어 주행을 방해할 수 있습니다.]]></Tip>
			<Type>2</Type>
		</ROW>
		<ROW>
			<Condition>0</Condition>
			<ConditionArg>0</ConditionArg>
			<ID>22</ID>
			<InitCount>1</InitCount>
			<Tip><![CDATA[천둥번개는 1등과 주변 라이벌들의 움직임을 봉쇄할 수 있습니다.]]></Tip>
			<Type>2</Type>
		</ROW>
		<ROW>
			<Condition>0</Condition>
			<ConditionArg>0</ConditionArg>
			<ID>23</ID>
			<InitCount>1</InitCount>
			<Tip><![CDATA[화염의 정령은 조준과정 없이 앞선 라이벌을 쓰러뜨릴 수 있습니다.]]></Tip>
			<Type>2</Type>
		</ROW>
		<ROW>
			<Condition>0</Condition>
			<ConditionArg>0</ConditionArg>
			<ID>24</ID>
			<InitCount>1</InitCount>
			<Tip><![CDATA[점프마비 마법은 앞선 라이벌 모두를 점프 불능 상태로 만들 수 있습니다.]]></Tip>
			<Type>2</Type>
		</ROW>
		<ROW>
			<Condition>0</Condition>
			<ConditionArg>0</ConditionArg>
			<ID>25</ID>
			<InitCount>1</InitCount>
			<Tip><![CDATA[가속 마법은 순간적으로 말의 속도를 증가시켜 역전에 효과적입니다.]]></Tip>
			<Type>2</Type>
		</ROW>
		<ROW>
			<Condition>0</Condition>
			<ConditionArg>0</ConditionArg>
			<ID>26</ID>
			<InitCount>1</InitCount>
			<Tip><![CDATA[빙벽을 이용하여 뒤쫓아오는 라이벌의 주행을 방해해 보세요]]></Tip>
			<Type>2</Type>
		</ROW>
		<ROW>
			<Condition>0</Condition>
			<ConditionArg>0</ConditionArg>
			<ID>27</ID>
			<InitCount>1</InitCount>
			<Tip><![CDATA[상황판에 기록되는 나를 공격한 상대에게 치명적인 복수를 해보세요.]]></Tip>
			<Type>2</Type>
		</ROW>
		<ROW>
			<Condition>0</Condition>
			<ConditionArg>0</ConditionArg>
			<ID>28</ID>
			<InitCount>1</InitCount>
			<Tip><![CDATA[필드에 놓여져 있는 마법을 놓치지마세요. 끊임없는 마법 사용은 최선의 공격입니다.]]></Tip>
			<Type>2</Type>
		</ROW>
		<ROW>
			<Condition>0</Condition>
			<ConditionArg>0</ConditionArg>
			<ID>29</ID>
			<InitCount>1</InitCount>
			<Tip><![CDATA[복수대상에게 통쾌한 복수도 하고 보상도 획득해 보세요.]]></Tip>
			<Type>2</Type>
		</ROW>
		<ROW>
			<Condition>0</Condition>
			<ConditionArg>0</ConditionArg>
			<ID>30</ID>
			<InitCount>1</InitCount>
			<Tip><![CDATA[절벽 추락시 <R>키를 누르면 빠르게 코스로 되돌아옵니다.]]></Tip>
			<Type>0</Type>
		</ROW>
		<ROW>
			<Condition>0</Condition>
			<ConditionArg>0</ConditionArg>
			<ID>31</ID>
			<InitCount>1</InitCount>
			<Tip><![CDATA[<Insert>키를 누르면 플레이어 시점이 변경됩니다.]]></Tip>
			<Type>0</Type>
		</ROW>
		<ROW>
			<Condition>0</Condition>
			<ConditionArg>0</ConditionArg>
			<ID>32</ID>
			<InitCount>1</InitCount>
			<Tip><![CDATA[경기중 <C>키를 누르면 플레이어 뒤를 돌아 볼 수 있습니다.]]></Tip>
			<Type>0</Type>
		</ROW>
		<ROW>
			<Condition>0</Condition>
			<ConditionArg>0</ConditionArg>
			<ID>33</ID>
			<InitCount>1</InitCount>
			<Tip><![CDATA[경기중 <Tab>키를 누르면 전체맵을 볼 수 있습니다.]]></Tip>
			<Type>0</Type>
		</ROW>
		<ROW>
			<Condition>1</Condition>
			<ConditionArg>10</ConditionArg>
			<ID>34</ID>
			<InitCount>1</InitCount>
			<Tip><![CDATA[교배소에서 자신의 말과 씨수마를 선택하여 교배에 도전해보세요.]]></Tip>
			<Type>0</Type>
		</ROW>
		<ROW>
			<Condition>1</Condition>
			<ConditionArg>10</ConditionArg>
			<ID>35</ID>
			<InitCount>1</InitCount>
			<Tip><![CDATA[교배소에 말 검색하기를 이용하여 마음에 드는 씨수마를 쉽게 찾아보세요.]]></Tip>
			<Type>0</Type>
		</ROW>
		<ROW>
			<Condition>1</Condition>
			<ConditionArg>10</ConditionArg>
			<ID>36</ID>
			<InitCount>1</InitCount>
			<Tip><![CDATA[망아지는 부모마의 능력치와 형질을 유전받습니다.]]></Tip>
			<Type>0</Type>
		</ROW>
		<ROW>
			<Condition>1</Condition>
			<ConditionArg>10</ConditionArg>
			<ID>37</ID>
			<InitCount>1</InitCount>
			<Tip><![CDATA[훌륭한 씨수마를 등록하여 다른 유저들에게 많은 교배비를 받아 보세요.]]></Tip>
			<Type>0</Type>
		</ROW>
		<ROW>
			<Condition>0</Condition>
			<ConditionArg>0</ConditionArg>
			<ID>38</ID>
			<InitCount>1</InitCount>
			<Tip><![CDATA[말마다 좋아하는 먹이가 다릅니다. 식성을 파악하여 효과적으로 관리해 보세요.]]></Tip>
			<Type>0</Type>
		</ROW>
		<ROW>
			<Condition>0</Condition>
			<ConditionArg>0</ConditionArg>
			<ID>39</ID>
			<InitCount>1</InitCount>
			<Tip><![CDATA['말관리'를 통해서 말과 좀 더 가까워지면 놀아주기를 할 수 있습니다.]]></Tip>
			<Type>0</Type>
		</ROW>
		<ROW>
			<Condition>0</Condition>
			<ConditionArg>0</ConditionArg>
			<ID>40</ID>
			<InitCount>1</InitCount>
			<Tip><![CDATA[기분이 좋지 않은 말에 마우스를 가져가면 현재 상태를 알 수 있습니다.]]></Tip>
			<Type>0</Type>
		</ROW>
		<ROW>
			<Condition>0</Condition>
			<ConditionArg>0</ConditionArg>
			<ID>41</ID>
			<InitCount>1</InitCount>
			<Tip><![CDATA[다양한 관리 스킬을 이용하여 말들의 기분을 UP해 주세요.]]></Tip>
			<Type>0</Type>
		</ROW>
		<ROW>
			<Condition>0</Condition>
			<ConditionArg>0</ConditionArg>
			<ID>42</ID>
			<InitCount>1</InitCount>
			<Tip><![CDATA[목장에서 말을 클릭하거나 <SpaceBar>를 누르면 주위의 말들을 부를 수 있습니다.]]></Tip>
			<Type>0</Type>
		</ROW>
		<ROW>
			<Condition>0</Condition>
			<ConditionArg>0</ConditionArg>
			<ID>43</ID>
			<InitCount>1</InitCount>
			<Tip><![CDATA[친밀도가 낮으면 목장에서 말들을 불러도 반응하지 않습니다.]]></Tip>
			<Type>0</Type>
		</ROW>
		<ROW>
			<Condition>0</Condition>
			<ConditionArg>0</ConditionArg>
			<ID>44</ID>
			<InitCount>1</InitCount>
			<Tip><![CDATA[목장에 있는 '워프장치'를 통해서 다른 유저의 목장을 방문해 보세요.]]></Tip>
			<Type>0</Type>
		</ROW>
		<ROW>
			<Condition>0</Condition>
			<ConditionArg>0</ConditionArg>
			<ID>48</ID>
			<InitCount>1</InitCount>
			<Tip><![CDATA['카니발 오디션'을 성공하여 상금이 걸린 카니발 참가 티켓 획득에 도전해보세요.]]></Tip>
			<Type>0</Type>
		</ROW>
		<ROW>
			<Condition>0</Condition>
			<ConditionArg>0</ConditionArg>
			<ID>49</ID>
			<InitCount>1</InitCount>
			<Tip><![CDATA['도전과제'를 모두 성공하면 특별한 보상을 얻을 수 있습니다.]]></Tip>
			<Type>0</Type>
		</ROW>
		<ROW>
			<Condition>0</Condition>
			<ConditionArg>0</ConditionArg>
			<ID>50</ID>
			<InitCount>2</InitCount>
			<Tip><![CDATA['개인정보창 스킬등록'을 통해서 다양한 주행 전략을 사용해보세요.]]></Tip>
			<Type>0</Type>
		</ROW>
		<ROW>
			<Condition>0</Condition>
			<ConditionArg>0</ConditionArg>
			<ID>51</ID>
			<InitCount>1</InitCount>
			<Tip><![CDATA[말의 모든 '숙련도'를 달성하여 멋있는 '엠블럼'을 획득 해 보세요.]]></Tip>
			<Type>0</Type>
		</ROW>
		<ROW>
			<Condition>0</Condition>
			<ConditionArg>0</ConditionArg>
			<ID>52</ID>
			<InitCount>1</InitCount>
			<Tip><![CDATA[경기에서 1등을 하면 시상식 중 <SpaceBar>를 이용하여 세레모니를 할 수 있습니다.]]></Tip>
			<Type>0</Type>
		</ROW>
		<ROW>
			<Condition>0</Condition>
			<ConditionArg>0</ConditionArg>
			<ID>53</ID>
			<InitCount>2</InitCount>
			<Tip><![CDATA[박차가 끝나기전 연속으로 박차를 사용할 경우 랜덤으로 추가 속도를 받습니다.]]></Tip>
			<Type>1</Type>
		</ROW>
		<ROW>
			<Condition>0</Condition>
			<ConditionArg>0</ConditionArg>
			<ID>54</ID>
			<InitCount>1</InitCount>
			<Tip><![CDATA[세레모니가 표시된 '도전과제 아이콘'을 등록하면 골라인 통과시 말이 멋진 모션을 취합니다.]]></Tip>
			<Type>0</Type>
		</ROW>
		<ROW>
			<Condition>0</Condition>
			<ConditionArg>0</ConditionArg>
			<ID>55</ID>
			<InitCount>1</InitCount>
			<Tip><![CDATA[조작이 불편하신가요? '환경설정'에서 조작키를 바꾸어보세요.]]></Tip>
			<Type>0</Type>
		</ROW>
		<ROW>
			<Condition>0</Condition>
			<ConditionArg>0</ConditionArg>
			<ID>56</ID>
			<InitCount>1</InitCount>
			<Tip><![CDATA[친구와 단둘이 대화하고 싶으신가요? '메신저'를 통해 친구를 등록해보세요.]]></Tip>
			<Type>0</Type>
		</ROW>
