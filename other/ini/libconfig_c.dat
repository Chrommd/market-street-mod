	<TABLE name='BreedingStrings' RowCount='31' TableInfoID = '341' FieldCnt = '2'>
		<FIELDINFO Name='KEY' IsKey='1' DataType='String'></FIELDINFO>
		<FIELDINFO Name='Value' IsKey='0' DataType='String'></FIELDINFO>
		<ROW>
			<KEY><![CDATA[BreedingSuccessMail]]></KEY>
			<Value><![CDATA[안녕하세요~ 교배소 스타토입니다.
$1님이 등록하신 "$2"의 교배소 등록이 종료되었습니다.
교배가 이루어진 횟수: $3회
총 교배 금액: $4 캐롯
수수료는 $5%로 누진 적용되었습니다.
최종 지급금액: $6 캐롯]]></Value>
		</ROW>
		<ROW>
			<KEY><![CDATA[Breeding_MinimumCharge]]></KEY>
			<Value><![CDATA[%d 등급의 최소 교배비는 %d 캐롯입니다.]]></Value>
		</ROW>
		<ROW>
			<KEY><![CDATA[Breeding_HorseName]]></KEY>
			<Value><![CDATA[망아지 이름 지어주기]]></Value>
		</ROW>
		<ROW>
			<KEY><![CDATA[Breeding_HorseName_ask1]]></KEY>
			<Value><![CDATA[망아지 이름을 지어주세요]]></Value>
		</ROW>
		<ROW>
			<KEY><![CDATA[Breeding_DelWishList]]></KEY>
			<Value><![CDATA[정말 삭제하시겠습니까?]]></Value>
		</ROW>
		<ROW>
			<KEY><![CDATA[Breeding_LimiteGrade]]></KEY>
			<Value><![CDATA[Requires Grade %d.]]></Value>
		</ROW>
		<ROW>
			<KEY><![CDATA[Breeding_SerialSuccess]]></KEY>
			<Value><![CDATA[%d회 연속 교배에 성공했습니다]]></Value>
		</ROW>
		<ROW>
			<KEY><![CDATA[Breeding_Notice_FineGrade]]></KEY>
			<Value><![CDATA[축하합니다!! %s님께서 자신의 말보다 %d등급 높은 %s등급의 망아지를 얻으셨습니다.]]></Value>
		</ROW>
		<ROW>
			<KEY><![CDATA[Breeding_FeeComment]]></KEY>
			<Value><![CDATA[* 등록비 : 받을 교배비의 ]]></Value>
		</ROW>
		<ROW>
			<KEY><![CDATA[Breeding_MaxSeedHorse]]></KEY>
			<Value><![CDATA[등록할 수 있는 씨수마는 %d마리까지입니다.]]></Value>
		</ROW>
		<ROW>
			<KEY><![CDATA[Breeding_CarrotNotEnough]]></KEY>
			<Value><![CDATA[등록비가 %d 캐롯 부족합니다.]]></Value>
		</ROW>
		<ROW>
			<KEY><![CDATA[Breeding_MaxmumCharge]]></KEY>
			<Value><![CDATA[받을 수 있는 교배비는 %d 캐롯까지 입니다.]]></Value>
		</ROW>
		<ROW>
			<KEY><![CDATA[Breeding_MaximumExpireTime]]></KEY>
			<Value><![CDATA[1일]]></Value>
		</ROW>
		<ROW>
			<KEY><![CDATA[Breeding_GetGameMoney]]></KEY>
			<Value><![CDATA[교배비를 받았습니다.]]></Value>
		</ROW>
		<ROW>
			<KEY><![CDATA[Breeding_FailGameMoney]]></KEY>
			<Value><![CDATA[이미 교배비를 받았습니다.]]></Value>
		</ROW>
		<ROW>
			<KEY><![CDATA[Breed_FailMount_Stamina]]></KEY>
			<Value><![CDATA[말이 지쳐서 달릴 수 없습니다. 체력을 회복해 주세요]]></Value>
		</ROW>
		<ROW>
			<KEY><![CDATA[Breeding_Menu_Breed]]></KEY>
			<Value><![CDATA[교배하기]]></Value>
		</ROW>
		<ROW>
			<KEY><![CDATA[Breeding_Menu_SeedMount]]></KEY>
			<Value><![CDATA[Register]]></Value>
