			<Value><![CDATA[이름을 변경하면 <font color=#ff7e00>게임이 종료</font>되며
<font color=#ff7e00>다시 접속했을 때 </font>변경한 이름으로 적용됩니다.]]></Value>
		</ROW>
		<ROW>
			<KEY><![CDATA[btn_no]]></KEY>
			<Value><![CDATA[Cancel]]></Value>
		</ROW>
		<ROW>
			<KEY><![CDATA[btn_yes]]></KEY>
			<Value><![CDATA[변경하기]]></Value>
		</ROW>
