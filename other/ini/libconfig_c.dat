	<TABLE name='2ndPasswordUIStrings' RowCount='9' TableInfoID = '471' FieldCnt = '2'>
		<FIELDINFO Name='KEY' IsKey='1' DataType='String'></FIELDINFO>
		<FIELDINFO Name='Value' IsKey='0' DataType='String'></FIELDINFO>
		<ROW>
			<KEY><![CDATA[ErrorNoName]]></KEY>
			<Value><![CDATA[Please enter your name.]]></Value>
		</ROW>
		<ROW>
			<KEY><![CDATA[ErrorIDNumberIsNotNumber]]></KEY>
			<Value><![CDATA[The ID number contains non-numeric characters.]]></Value>
		</ROW>
		<ROW>
			<KEY><![CDATA[ErrorShortPswd]]></KEY>
			<Value><![CDATA[The password must be a 4-digit number.]]></Value>
		</ROW>
		<ROW>
			<KEY><![CDATA[ErrorPswdIsNotNumber]]></KEY>
			<Value><![CDATA[The password contains non-numeric characters.]]></Value>
		</ROW>
		<ROW>
			<KEY><![CDATA[ErrorPswdMissmatch]]></KEY>
			<Value><![CDATA[비밀번호가 일치하지 않습니다.]]></Value>
		</ROW>
		<ROW>
			<KEY><![CDATA[ErrorWebCertification]]></KEY>
			<Value><![CDATA[인증이 실패했습니다. 다시 시도해 주세요.]]></Value>
		</ROW>
		<ROW>
			<KEY><![CDATA[ErrorShortIDNumber]]></KEY>
			<Value><![CDATA[주민등록번호가 잘못 입력되었습니다.]]></Value>
		</ROW>
		<ROW>
			<KEY><![CDATA[DescCreate]]></KEY>
			<Value><![CDATA[사용자 보호를 위한 2차 비밀번호를 설정합니다.
가입된 회원 정보를 입력하세요.
<font color="#FF5A5A">* 비밀번호는 네자리 숫자입니다.</font>]]></Value>
		</ROW>
		<ROW>
			<KEY><![CDATA[DescConfirm]]></KEY>
			<Value><![CDATA[해당 기능을 사용하시려면 2차 비밀번호를 입력해주세요.
<font color="#FF5A5A">* 비밀번호는 네자리 숫자입니다.</font>]]></Value>
		</ROW>
	</TABLE>
