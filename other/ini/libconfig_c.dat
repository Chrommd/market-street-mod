			<Image><![CDATA[img_quest_npc_002-confuse1]]></Image>
			<NpcID>2</NpcID>
			<Priority>6</Priority>
			<QuestPack>0</QuestPack>
			<QuestTID>12021</QuestTID>
			<Speech><![CDATA[읍! 아무것도 아녜요...헤헤…]]></Speech>
			<Voice><![CDATA[ ]]></Voice>
		</ROW>
