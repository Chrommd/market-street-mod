			<Value><![CDATA[이름을 지어주세요.]]></Value>
		</ROW>
		<ROW>
			<KEY><![CDATA[CR_INVALID_NICKNAME]]></KEY>
			<Value><![CDATA[허용하지 않는 글자가 포함되어 있습니다.]]></Value>
		</ROW>
		<ROW>
			<KEY><![CDATA[BadName]]></KEY>
			<Value><![CDATA[Name contains inappropriate words.]]></Value>
		</ROW>
		<ROW>
