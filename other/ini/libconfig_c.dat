		</ROW>
		<ROW>
			<Chat><![CDATA[Thank you for coming so quickly after receiving my letter, $(Name)!
This is our first time meeting in person, isn’t it?]]></Chat>
			<ConditionID>0</ConditionID>
			<ConditionType>3</ConditionType>
			<ID>7</ID>
			<Ignore>1</Ignore>
			<NpcID>1</NpcID>
			<ParentButtons>1</ParentButtons>
			<ParentIDs><![CDATA[6]]></ParentIDs>
			<Priority>0</Priority>
			<VoiceFile><![CDATA[ ]]></VoiceFile>
		</ROW>
		<ROW>
			<Chat><![CDATA[It’s a pleasure to meet you. I’m Thomas,
the old man who's in Management of this Ranch.]]></Chat>
			<ConditionID>0</ConditionID>
			<ConditionType>3</ConditionType>
			<ID>8</ID>
			<Ignore>1</Ignore>
			<NpcID>1</NpcID>
			<ParentButtons>1</ParentButtons>
			<ParentIDs><![CDATA[7]]></ParentIDs>
			<Priority>0</Priority>
			<VoiceFile><![CDATA[ ]]></VoiceFile>
		</ROW>
		<ROW>
			<Chat><![CDATA[You must be tired from coming such a long way. Hahaha
Welcome to our ranch!]]></Chat>
			<ConditionID>0</ConditionID>
			<ConditionType>3</ConditionType>
			<ID>9</ID>
			<Ignore>1</Ignore>
			<NpcID>1</NpcID>
			<ParentButtons>1</ParentButtons>
			<ParentIDs><![CDATA[8]]></ParentIDs>
			<Priority>0</Priority>
			<VoiceFile><![CDATA[ ]]></VoiceFile>
		</ROW>
		<ROW>
			<Chat><![CDATA[As you care for horses and race here,
you’ll discover many new sides to them.]]></Chat>
			<ConditionID>0</ConditionID>
			<ConditionType>3</ConditionType>
			<ID>10</ID>
			<Ignore>1</Ignore>
			<NpcID>1</NpcID>
			<ParentButtons>1</ParentButtons>
			<ParentIDs><![CDATA[9]]></ParentIDs>
			<Priority>0</Priority>
			<VoiceFile><![CDATA[ ]]></VoiceFile>
		</ROW>
		<ROW>
			<Chat><![CDATA[Even a horse that looks unimpressive at first
will awaken its racing instinct if you ride it well.
So take care of it with affection.]]></Chat>
			<ConditionID>0</ConditionID>
			<ConditionType>3</ConditionType>
			<ID>11</ID>
			<Ignore>1</Ignore>
