	<TABLE name='HousingStrings' RowCount='26' TableInfoID = '430' FieldCnt = '2'>
		<FIELDINFO Name='KEY' IsKey='1' DataType='String'></FIELDINFO>
		<FIELDINFO Name='Value' IsKey='0' DataType='String'></FIELDINFO>
		<ROW>
			<KEY><![CDATA[BuildError]]></KEY>
			<Value><![CDATA[시설물 설치에 실패했습니다.]]></Value>
